repository-code: "https://github.com/aduton1000/familyforge"
keywords:
  - bioinformatics
  - clinical genomics
  - variant interpretation
  - ACMG classification
  - Mendelian inheritance
  - pedigree analysis
  - rare disease
references:
  - type: software
    title: "CallForge: a targeted-capture germline analysis pipeline"
    repository-code: "https://github.com/aduton1000/callforge"
    notes: "Upstream analysis pipeline; FamilyForge consumes its annotated joint VCF, cnv_calls.tsv, and provenance.json."
  - type: software
    title: "CaptureForge: a general-purpose, organism-agnostic hybridization-capture probe (bait) design pipeline"
    repository-code: "https://github.com/aduton1000/captureforge"
    notes: "Design-stage pipeline at the head of the forge family (CaptureForge -> CallForge -> FamilyForge)."
